  55:Core/Src/main.c **** int main(void) {
  56:Core/Src/main.c ****     Clock_Config_72MHz(); 
  57:Core/Src/main.c ****     Timer2_Init_1200Hz();
  58:Core/Src/main.c **** 
  59:Core/Src/main.c ****     const float invT1 = 1.0f / T1;
  60:Core/Src/main.c ****     const float invT2 = 1.0f / T2;
  61:Core/Src/main.c ****     const float invT4 = 1.0f / T4;
  62:Core/Src/main.c ****     const float dt = SIM_DT_FAST;
  63:Core/Src/main.c **** 
  64:Core/Src/main.c ****     while(1) {
  65:Core/Src/main.c ****         float u_in = current_x1 * GAIN_FIX;
  66:Core/Src/main.c **** 
  67:Core/Src/main.c ****         // Модель объекта
  68:Core/Src/main.c ****         Y1_st += (K1 * u_in - Y1_st) * invT1 * dt;
  69:Core/Src/main.c ****         Y2_st += (K3 * Y1_st - Y2_st) * invT2 * dt;
  70:Core/Src/main.c ****         Y4_st += (K4 * Y2_st - Y4_st) * invT4 * dt;
  71:Core/Src/main.c **** 
  72:Core/Src/main.c ****         // ЗАЩИТЫ (Срабатывают при превышении в любую стор�
  73:Core/Src/main.c ****         if (Y4_st > SPEED_LIMIT || Y4_st < -SPEED_LIMIT || Y2_st > Y2_LIMIT || Y2_st < -Y2_LIMIT) {
  74:Core/Src/main.c ****             system_fault = 1; 
  75:Core/Src/main.c ****         }
  76:Core/Src/main.c ****     }
  77:Core/Src/main.c **** }
